# --- core ---
DATABASE_URL=postgresql://claimpilot:localdev@localhost:5433/claimpilot
## postgresql://USER:PASSWORD@HOST:PORT/DATABASE (Supabase runtime: 6543 transaction pooler + DB_PREPARE=false)
DB_PREPARE=true
WEB_ORIGIN=http://localhost:5173

# --- auth (Supabase) ---
SUPABASE_URL=xxx
SUPABASE_ANON_KEY=xxx
SUPABASE_JWT_SECRET=xxx

# --- storage: local (dev/CI) | supabase (deployed) ---
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/uploads
# SUPABASE_SERVICE_ROLE_KEY=xxx   # required when STORAGE_DRIVER=supabase

# --- payments ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- LLM (Gemini) ---
GEMINI_API_KEY=xxx
GEMINI_MODEL=gemini-flash-lite-latest       # chat + extraction (fast)
GEMINI_VISION_MODEL=gemini-flash-latest     # damage verdict (quality)
LLM_TIMEOUT_MS=60000

# --- ml-service (YOLOv8) ---
ML_SERVICE_URL=http://localhost:8010
ML_TIMEOUT_MS=15000
